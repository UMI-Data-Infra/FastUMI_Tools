Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.45
      Cell Size: 1
      Color: 110; 125; 140
      Plane: XY
      Plane Cell Count: 20
      Value: true
    - Class: rviz/Path
      Name: Trajectory
      Enabled: true
      Topic: /xv_sdk/${XV_DEVICE_SERIAL}/slam/trajectory
      Color: 21; 214; 190
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.035
      Pose Style: None
      Value: true
    - Class: rviz/Pose
      Name: Current Pose
      Enabled: true
      Topic: /xv_sdk/${XV_DEVICE_SERIAL}/slam/current_pose
      Color: 41; 153; 255
      Alpha: 1
      Shape: Arrow
      Shaft Length: 0.22
      Shaft Radius: 0.025
      Head Length: 0.08
      Head Radius: 0.05
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 12; 20; 29
    Default Light: true
    Fixed Frame: ${XV_DEVICE_SERIAL}/map_optical_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7
      Target Frame: <Fixed Frame>
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
